{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    { "path": "pages/auth/login", "style": { "navigationBarTitleText": "登录", "navigationStyle": "custom" } },
    { "path": "pages/auth/register", "style": { "navigationBarTitleText": "注册", "navigationStyle": "custom" } },
    { "path": "pages/auth/forgot-password", "style": { "navigationBarTitleText": "找回密码", "navigationStyle": "custom" } },
    { "path": "pages/auth/reset-password", "style": { "navigationBarTitleText": "设置新密码", "navigationStyle": "custom" } },
    { "path": "pages/ledger/index", "style": { "navigationBarTitleText": "账本", "navigationStyle": "custom" } },
    { "path": "pages/ledger/expense-statistics", "style": { "navigationBarTitleText": "费用统计", "navigationStyle": "custom" } },
    { "path": "pages/ledger/category-transactions", "style": { "navigationBarTitleText": "分类流水" } },
    { "path": "pages/ledger/transaction-form", "style": { "navigationBarTitleText": "新增流水", "navigationStyle": "custom", "app-plus": { "adjustPan": true }, "mp-weixin": { "disableScroll": true } } },
    { "path": "pages/ledger/categories", "style": { "navigationBarTitleText": "收支分类" } },
    { "path": "pages/ledger/budget", "style": { "navigationBarTitleText": "预算管理" } },
    { "path": "pages/ledger/monthly-report", "style": { "navigationBarTitleText": "月度账单" } },
    { "path": "pages/ledger/monthly-report-detail", "style": { "navigationBarTitleText": "账单详情" } },
    { "path": "pages/chat/index", "style": { "navigationBarTitleText": "AI 助手", "navigationStyle": "custom", "app-plus": { "adjustPan": true }, "mp-weixin": { "disableScroll": true } } },
    { "path": "pages/profile/index", "style": { "navigationBarTitleText": "我的", "navigationStyle": "custom" } },
    { "path": "pages/profile/theme-settings", "style": { "navigationBarTitleText": "主题外观" } },
    { "path": "pages/profile/info", "style": { "navigationBarTitleText": "个人信息" } },
    { "path": "pages/profile/change-password", "style": { "navigationBarTitleText": "修改密码" } },
    { "path": "pages/profile/account-security", "style": { "navigationBarTitleText": "账号安全" } },
    { "path": "pages/profile/verify-old-email", "style": { "navigationBarTitleText": "验证原邮箱" } },
    { "path": "pages/profile/bind-email", "style": { "navigationBarTitleText": "绑定邮箱" } }
  ],
  "tabBar": {
    "custom": true,
    "color": "#8b95a7",
    "selectedColor": "#1677ff",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "fontSize": "12px",
    "iconWidth": "28px",
    "height": "56px",
    "list": [
      { "pagePath": "pages/ledger/index", "text": "账本", "iconPath": "static/tabbar/ledger.png", "selectedIconPath": "static/tabbar/ledger-active.png" },
      { "pagePath": "pages/ledger/expense-statistics", "text": "统计", "iconPath": "static/tabbar/statistics.png", "selectedIconPath": "static/tabbar/statistics-active.png" },
      { "pagePath": "pages/chat/index", "text": "助手", "iconPath": "static/tabbar/assistant.png", "selectedIconPath": "static/tabbar/assistant-active.png" },
      { "pagePath": "pages/profile/index", "text": "我的", "iconPath": "static/tabbar/profile.png", "selectedIconPath": "static/tabbar/profile-active.png" }
    ]
  },
  "globalStyle": {
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f5f7fb"
  }
}
